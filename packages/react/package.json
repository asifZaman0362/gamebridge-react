{
  "name": "@gamebridge-react/react",
  "version": "0.1.0",
  "description": "React hooks for @gamebridge-react/core: subscribe to and emit bridge events from a component.",
  "keywords": ["event-bridge", "react", "hooks", "phaser", "pixi", "events", "game", "canvas"],
  "homepage": "https://github.com/asifZaman0362/gamebridge-react/tree/main/packages/react#readme",
  "bugs": "https://github.com/asifZaman0362/gamebridge-react/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asifZaman0362/gamebridge-react.git",
    "directory": "packages/react"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@gamebridge-react/core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "author": "Asif Zaman <zero362001@gmail.com>",
  "license": "MIT"
}
